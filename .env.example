# Copy this file to ".env" (same folder) and fill in your values. Restart the app after changes.

# Azure OpenAI (used by default when all four are filled in)
AZURE_OPENAI_API_KEY=your-azure-key
AZURE_OPENAI_ENDPOINT=https://your-resource.openai.azure.com/
AZURE_OPENAI_DEPLOYMENT=your-deployment-name
AZURE_OPENAI_API_VERSION=2024-10-21

# The name users see for the AI (the real provider and model are never shown)
AI_DISPLAY_NAME=AI Analyst

# Optional: Anthropic Claude instead (set AI_PROVIDER=anthropic)
# AI_PROVIDER=anthropic
# ANTHROPIC_API_KEY=sk-ant-...

# Optional: change the port (default 8000)
# PORT=8000

# Online deployment: login for the site (strongly recommended)
# APP_USERNAME=admin
# APP_PASSWORD=choose-a-strong-password

# ---------------- Extra news sources (all optional) ----------------
# Free keys. Each source switches on automatically when its key is present.
# YOUTUBE_API_KEY=      (Google Cloud Console > YouTube Data API v3)
# NEWSAPI_KEY=          (newsapi.org; free plan is for development only)
# FINNHUB_KEY=          (finnhub.io; company news for US stocks)
# REDDIT_CLIENT_ID=     (reddit.com/prefs/apps > create "script" app; makes Reddit reliable on servers)
# REDDIT_CLIENT_SECRET=
# Turn off any source by id, comma separated:
# DISABLED_SOURCES=bing_news,gdelt
# Where saved keyword profiles are kept (use a Render persistent disk path to keep them across deploys):
# DATA_DIR=/var/data

# ---------------- Surveillance alerts (material price movement) ----------------
# Public address of the app, used for links in alert emails:
# APP_BASE_URL=https://drishti.onrender.com
# Email can now be set up inside the app (Setup > Email and notifications). These variables are a fallback.
# Encryption key for passwords saved in the app (any long random text; keep it the same once set):
# APP_SECRET=
# Option 0, Brevo (HTTPS API, works on Render's free plan; verify the sender email in Brevo):
# BREVO_API_KEY=xkeysib-...
# MAIL_FROM=Drishti Alerts <you@gmail.com>
# Email: or configure ONE option below.
# Option A, SMTP (Gmail app password, Office 365, Zoho...):
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=587
# SMTP_USER=alerts@yourcompany.com
# SMTP_PASSWORD=your-app-password
# SMTP_FROM=Drishti Alerts <alerts@yourcompany.com>
# Option B, Resend (HTTPS email API, works where SMTP ports are blocked):
# RESEND_API_KEY=re_...
# MAIL_FROM=Drishti Alerts <alerts@yourdomain.com>
# X (Twitter) monitoring needs a paid X API plan:
# X_BEARER_TOKEN=
